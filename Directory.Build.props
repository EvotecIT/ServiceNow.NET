<Project>
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Keep the shared family compatible with the supported .NET 8, .NET 9 and .NET Standard assets. -->
    <MicrosoftDependencyVersion>11.0.0</MicrosoftDependencyVersion>
    <MicrosoftDependencyVersion Condition="'$(TargetFramework)' == 'net10.0'">11.0.0</MicrosoftDependencyVersion>    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
